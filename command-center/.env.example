# ==============================================================================
# Command Center Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=production

# Sports Data Providers
# Set to 'true' to enforce deterministic offline fixtures for development and testing
USE_MOCK_SPORTS=false

# Optional API Keys (Not required for default free/public endpoints)
# OPENROUTER_API_KEY=sk-or-v1-...  # Optional for live custom LLM generation
# FOOTBALL_DATA_API_KEY=...        # Optional fallback for European football

# Cache and Timeout Tuning
CACHE_TTL_MARKETS_ACTIVE=60
CACHE_TTL_MARKETS_IDLE=900
CACHE_TTL_NEWS=600
CACHE_TTL_MODELS=1800
CACHE_TTL_BRIEFING=10800
