# ==============================================================================
# MatchLab API Keys Configuration
# Copy this file to .env (same directory) and fill in your keys.
# .env is git-ignored and will not be committed.
# Keys saved under Settings in the web dashboard take priority over this file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. TENNIS APIS
# ------------------------------------------------------------------------------

# AcesAPI (https://acesapi.com/signup)
# Free tier: 500 credits/month (used for surface Elo & head-to-head records)
ACESAPI_KEY=

# Live Tennis API (https://livetennisapi.com)
# Free tier: 100 requests/day (live scores, point narratives, tournament draws)
LIVE_TENNIS_API_KEY=

# Matchstat Tennis API (https://matchstat.com or RapidAPI)
# Free tier: 50-100 requests/day on RapidAPI (historical stats, deep H2H, surface records)
MATCHSTAT_API_KEY=

# API-Tennis (https://api-tennis.com)
# Free trial / Developer tier (live scores, point-by-point, fixtures)
API_TENNIS_KEY=

# ------------------------------------------------------------------------------
# 2. MULTI-SPORT, LIVE SCORES & ODDS APIS
# ------------------------------------------------------------------------------

# The Odds API (https://the-odds-api.com)
# Free tier: 500 requests/month (live bookmaker odds & market implied probabilities)
THE_ODDS_API_KEY=

# CricketData.org / CricAPI (https://cricketdata.org)
# Free tier: 100 requests/day (live cricket match scores & ball-by-ball updates)
CRICKETDATA_API_KEY=

# Football-Data.org (https://www.football-data.org/client/register)
# Free tier: 10 requests/min (live Premier League & European fixtures, scores, standings)
FOOTBALL_DATA_API_KEY=

# OpenF1 (https://openf1.org)
# Free tier: finished sessions (no key needed). Paid/token key for live lap-by-lap timing.
OPENF1_API_KEY=

# ------------------------------------------------------------------------------
# 3. AI SECOND OPINION & MATCH ANALYSIS
# ------------------------------------------------------------------------------

# Google Gemini API (https://aistudio.google.com/app/apikey)
# Free tier: backup for OpenRouter (AI checks, summaries, previews, World briefing).
# With Google Search grounding enabled (billing on the key's AI Studio project) it also supplies fixtures and
# scores as a last resort once CricketData.org hits its daily limit. See DATA_SOURCES.md.
GEMINI_API_KEY=

# OpenRouter (https://openrouter.ai/keys)
# Free models (begins with sk-or-v1-)
OPENROUTER_API_KEY=
